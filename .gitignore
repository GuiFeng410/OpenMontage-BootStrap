# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Local model downloads (e.g. Piper TTS voices, fetched at runtime — not source)
*.onnx
*.onnx.json

# Test/IDE
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.trae/
.idea/
.vscode/

# Pipeline outputs (regenerable — never commit large media)
output/
pipeline/
tests/qa/output/

# Project workspaces (generated assets, renders — all regenerable)
projects/

# Corpus directories (downloaded stock clips, thumbnails, embeddings —
# regenerable from source APIs via corpus_builder). Explicit rule even
# though most corpora live under projects/ since agents sometimes
# build scratch corpora at the repo root.
corpus/
**/corpus/

# User music library (personal royalty-free tracks — not part of repo)
music_library/

# Environment & credentials
.env
.env.local
*.env
.youtube-token.json
# Google service-account / Vertex AI keys — never commit
gcp-*.json
*-service-account.json
service-account*.json
service_account*.json

# Stray media downloads (test/scratch clips left in repo root)
pexels_video_*.mp4

# Scratch/debug scripts
scratch/

# Internal docs (strategy, handoffs, playbooks — not shipped)
internal/

# Local / exploratory docs — not part of BootStrap ship set
# (ship docs/新机导入三步/; keep chance_file / Mcp_Entity / handoffs local)
docs/chance_file/
docs/documents/
docs/Mcp_Entity/
# Local session handoffs — never push (new chats read here first)
docs/会话交接/

# name-to-workspace local trees (do not commit unless user asks)
/Agent-Docs/
/Agent-ReadMe/
/Agent-Temp/

# Local voice / model caches (fetched at install time — *.onnx already ignored above)
piper_models/
.piper/

# Local agent config (user-specific)
.claude/memory/
.claude/settings.local.json

# Agent skills lock (local install tracking)
skills-lock.json

# Generated images (logo drafts — final logo lives in assets/)
logo_*.png
generated_image.png

# Downloaded music files (Pixabay, Freesound — not source code)
pixabay_music_*

# OS
.DS_Store
Thumbs.db

# Node (for remotion-composer / runtimes/remotion / backlot/frontend)
node_modules/

# Backlot Vite default outDir if config is skipped (committed output is ui-dist/)
backlot/frontend/dist/

# Remotion build output and copied project assets (regenerable at render time)
runtimes/remotion/out/
remotion-composer/out/
# Project-local bespoke ("atelier") compositions — hand-authored per video,
# throwaway and regenerable. Keeps the shared src/ free of one-off scenes.
runtimes/remotion/projects/
remotion-composer/projects/
runtimes/remotion/public/*
remotion-composer/public/*
# But keep demo props (shipped with the project for zero-key demos)
!runtimes/remotion/public/demo-props/
!remotion-composer/public/demo-props/
# Ignore test/scratch compositions in demo-props (keep only curated demos)
runtimes/remotion/public/demo-props/test-*
runtimes/remotion/public/demo-props/talking-head-*
runtimes/remotion/public/demo-props/caption-burn-*
remotion-composer/public/demo-props/test-*
remotion-composer/public/demo-props/talking-head-*
remotion-composer/public/demo-props/caption-burn-*

venv/
.venv/

# Backlot local cache (thumbnails)
.backlot/

# Local install / env snapshot (no secrets; machine-specific)
.openmontage/

# Local Agent policies and one-off verification runners (not repository source)
/.cursor/rules/
/scripts/_run_assert03_20s_promo.py
/scripts/_run_assert04_20s_promo.py

# Local authentication / generated media / distributable skill archive
/agnes_image.png
/lark_auth_qrcode.png
/lark_auth_qrcode2.png
/openmontage/skills/openmontage-bootstrap-01-installer.zip
