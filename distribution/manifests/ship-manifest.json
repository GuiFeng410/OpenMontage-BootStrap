{
  "schema_version": 1,
  "layout": "tree-a",
  "copy_skip_dir_names": [
    "node_modules",
    "__pycache__",
    ".pytest_cache",
    ".git",
    ".venv"
  ],
  "core": {
    "files": [
      "AGENTS.md",
      "AGENT_GUIDE.md",
      "AGENT_GUIDE-upstream.md",
      "CLAUDE.md",
      "PRODUCT_MAP.md",
      "PROJECT_CONTEXT.md",
      "LICENSE",
      "README.md",
      "setup.py",
      "requirements.txt",
      "config.yaml",
      ".env.example"
    ],
    "dirs": [
      "lib",
      "src/openmontage",
      "openmontage",
      "backlot",
      "product",
      "schemas",
      "styles",
      "tools",
      "skills",
      "runtimes/remotion",
      "distribution/manifests",
      "README"
    ]
  },
  "optional": {
    "files": ["requirements-gpu.txt"],
    "dirs": ["ink-theater", "docs"]
  },
  "forbidden": [
    ".env",
    "projects",
    "Agent-Docs",
    "Agent-ReadMe",
    "Agent-Temp",
    ".venv",
    ".openmontage",
    "tests",
    ".claude",
    ".agents",
    ".cursor",
    ".github",
    "archive",
    "reports",
    "Commercial-Video"
  ],
  "forbidden_globs": ["*.egg-info", ".pytest_cache"],
  "developer_only": [
    "tests",
    "requirements-dev.txt",
    "Makefile",
    ".github",
    "agnes_image.png",
    "archive/diagram.png",
    "lark_auth_qrcode.png",
    "lark_auth_qrcode2.png",
    "archive/render_demo.py",
    "archive/render-demo.sh"
  ],
  "remotion": {
    "root": "runtimes/remotion",
    "exclude_dirs": ["node_modules", "out", ".cache", "projects"],
    "exclude_globs": ["src/Bangle*.tsx"]
  }
}
