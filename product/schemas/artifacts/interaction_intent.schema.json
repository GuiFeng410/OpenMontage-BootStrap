{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/interaction_intent",
  "title": "Interaction Intent",
  "description": "A versioned, project-local user interaction request that remains separate from canonical artifacts.",
  "type": "object",
  "required": [
    "version",
    "intent_type",
    "intent_id",
    "project_id",
    "stage",
    "revision",
    "summary",
    "summary_sha256",
    "payload",
    "expires_at",
    "created_at",
    "status"
  ],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "intent_type": {
      "type": "string",
      "enum": [
        "preference",
        "decision",
        "asset_review",
        "revision_request",
        "approval_bundle",
        "project_export"
      ]
    },
    "intent_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "stage": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1 },
    "summary_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payload": { "type": "object" },
    "provider": { "type": ["string", "null"], "minLength": 1 },
    "model": { "type": ["string", "null"], "minLength": 1 },
    "runtime": { "type": ["string", "null"], "minLength": 1 },
    "cost_cap_cny": { "type": ["number", "null"], "minimum": 0 },
    "call_cap": { "type": ["integer", "null"], "minimum": 0 },
    "expires_at": { "type": "string", "format": "date-time" },
    "created_at": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "planned",
        "approved",
        "applied",
        "superseded",
        "rejected",
        "failed"
      ]
    },
    "note": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
